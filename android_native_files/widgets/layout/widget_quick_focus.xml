<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oneir_widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:id="@+id/quick_focus_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOCUS"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#9A9A9A"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/quick_focus_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25 min"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2F2E2E" />

    <!-- Vanya's one-time-per-session encouragement (see
         OneirWidgetService.updateQuickFocus's halfway-point logic) --
         GONE by default, shown only for the one refresh where there's an
         actual message, same restraint rule as Today's Focus's message
         row. -->
    <TextView
        android:id="@+id/quick_focus_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="#A8A4D8"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

</LinearLayout>
